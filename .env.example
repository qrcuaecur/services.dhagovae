# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix this with NEXT_PUBLIC_ and never import it
# into a Client Component - it bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute base URL that QR codes encode. Changing this after codes are
# printed invalidates them, so lock the production domain before printing.
NEXT_PUBLIC_APP_URL=http://localhost:3000
